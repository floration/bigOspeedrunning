+/-- **μ(G) ≤ 269.78167.** The terminal `measure_of_data` holds for every rational `μ ≥ 269.78167`
+(its last condition is `μ > dρ/(η − 4dδ)`, which is `269.7816603…` at `δ = 10⁻¹²`, `η = etaC`). -/
+theorem catalan_irrationalityMeasure_26978167 :
+    ∀ᶠ b : ℕ in atTop, ∀ a : ℤ,
+      (b : ℝ) ^ (-(((26978167 / 100000 : ℚ)) : ℝ)) <
+        |(∑' j : ℕ, (-1 : ℝ) ^ j / ((2 * j + 1 : ℕ) : ℝ) ^ 2) - a / b| :=
+  measure_of_data (26978167 / 100000) (by norm_num) (by norm_num) firstData largeData nearData
+    HCirc.hcirc_d HCirc.hseg_d
+
+/-- The race form: for every real `s > 269.78167`, eventually `b^(-s) < |G - a/b|`. -/
+theorem catalan_upperBound_26978167 :
+    ∀ s : ℝ, ((26978167 / 100000 : ℚ) : ℝ) < s →
+      ∀ᶠ b : ℕ in atTop, ∀ a : ℤ,
+        (b : ℝ) ^ (-s) < |(∑' j : ℕ, (-1 : ℝ) ^ j / ((2 * j + 1 : ℕ) : ℝ) ^ 2) - a / b| := by
+  intro s hs
+  filter_upwards [catalan_irrationalityMeasure_26978167, eventually_ge_atTop 1] with b hb hb1 a
+  refine lt_of_le_of_lt ?_ (hb a)
+  have h1 : (1 : ℝ) ≤ b := by exact_mod_cast hb1
+  exact Real.rpow_le_rpow_of_exponent_le h1 (by linarith)
+
 end
 end CatalanMeasure.GenD.Signed.RouteI.Measure270
 
